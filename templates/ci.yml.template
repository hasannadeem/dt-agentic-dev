# Quality gates for the agentic pipeline.
#
# Generated by scripts/init-pipeline.mjs. Safe to edit — but note that agents
# are blocked from editing this file, deliberately: it is the thing that
# decides whether their work is acceptable.
#
# Layout and commands come from pipeline.config.json so this file does not need
# to change when the project does. Values are validated by scripts/ci-config.mjs
# and passed through `env:` rather than interpolated into `run:` — interpolating
# repository-controlled text into a shell is a command-injection path.
name: ci

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  platform:
    name: platform conventions
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - uses: actions/setup-node@39370e3970a6d050c480ffad4ff0ed4d3fdee5af # v4.1.0
        with:
          node-version: 22
      - name: Validate spec/task artifacts
        run: node scripts/validate-artifacts.mjs
      - name: Governance guard scenarios
        run: python3 .claude/hooks/guard_test.py

  secrets:
    name: secret scanning
    runs-on: ubuntu-latest
    # gitleaks-action reports findings onto the PR and needs write access there.
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
      - name: Scan history for secrets
        uses: gitleaks/gitleaks-action@83373cf2f8c4db6e24b41c1a9b086bb9619e9cd3 # v2.3.7
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  app:
    name: application gates
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - name: Read pipeline config
        id: cfg
        run: node scripts/ci-config.mjs >> "$GITHUB_OUTPUT"
      - uses: actions/setup-node@39370e3970a6d050c480ffad4ff0ed4d3fdee5af # v4.1.0
        with:
          node-version: 22
{{SETUP_STEPS}}
      - name: Install dependencies
        working-directory: ${{ steps.cfg.outputs.dir }}
        env:
          INSTALL_CMD: ${{ steps.cfg.outputs.install }}
        run: sh -c "$INSTALL_CMD"
      - name: Run gates
        working-directory: ${{ steps.cfg.outputs.dir }}
        env:
          GATES_CMD: ${{ steps.cfg.outputs.gates }}
        run: sh -c "$GATES_CMD"
